# Environment variables must be prefixed with VITE_ to reach the client bundle.

# The API is served from a separate origin in production, so requests go to this full URL.
# The backend must allow this site's origin (CORS + credentials) and expose the
# Content-Disposition header so file downloads keep their filename.
VITE_API_BASE_URL = 'https://continew-api.ruanruyi.cn'

# Not used by the production build: `server.port` only applies to the dev server.
# Kept so both env files expose the same keys.
VITE_APP_PORT = '5173'

# Client id that must exist in the backend sys_client table.
VITE_CLIENT_ID = 'ef51c9a3e9046c4f2ea45142c8a8344a'

# Must match the backend FIELD_ENCRYPT_PUBLIC_KEY value before building for production.
VITE_APP_RSA_PUBLIC_KEY = 'MFwwDQYJKoZIhvcNAQEBBQADSwAwSAJBAM51dgYtMyF+tTQt80sfFOpSV27a7t9uaUVeFrdGiVxscuizE7H8SMntYqfn9lp8a5GH5P1/GGehVjUD2gF/4kcCAwEAAQ=='
