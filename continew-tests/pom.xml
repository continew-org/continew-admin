<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>top.continew.admin</groupId>
        <artifactId>continew-admin</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>continew-tests</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>集中测试模块（存放不适合放入单个被测模块的测试类）</description>

    <properties>
        <!-- 本项目测试集合仅供本地与 reactor 内使用，不对外发布 -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- L3 API 测试组过滤开关：默认不执行 api 组；-Papi-test 时反向只执行该组 -->
        <surefire.groups></surefire.groups>
        <surefire.excludedGroups>api</surefire.excludedGroups>
    </properties>

    <dependencies>
        <!-- 被测模块：依赖方向为 tests -> 被测模块，被测模块不反向依赖本模块 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>continew-common</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>continew-system</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>continew-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers 集成测试（仅测试期使用；版本由 parent 依赖链的 spring-boot-dependencies 管理，不声明版本号） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- REST Assured（L3 API 黑盒测试，对脚本起的独立实例发真实 HTTP；版本由根 POM 统一管理） -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 保证本模块测试用例在 CI 中实际执行，不被跳过；
                 L3 API 黑盒测试以 @Tag("api") 标记，默认排除，-Papi-test 时反向只跑该组。
                 组过滤经属性间接配置：profile 无法用空标签覆盖父配置值（Maven 合并保留父值），
                 属性覆盖则是完全替换，故此处以属性占位 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <groups>${surefire.groups}</groups>
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                    <!-- continew-server 的默认瘦包 artifact 位于 target/app/bin，其 MANIFEST
                         Class-Path 指向 ../lib/ 下的整套依赖，会把它们再次拉入测试类路径，导致 MyBatis
                         classpath*:/mapper/** 重复解析同一 Mapper XML。测试期改用其编译输出目录，
                         避免瘦包 manifest 污染；server 的传递依赖不受影响 -->
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>${project.groupId}:continew-server</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                    <additionalClasspathElements>
                        <additionalClasspathElement>${project.basedir}/../continew-server/target/classes</additionalClasspathElement>
                    </additionalClasspathElements>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- L3 API 黑盒测试：只运行 @Tag("api") 组，配合 scripts/test/api-smoke.sh 对脚本起的独立实例发真实 HTTP；
             命令行需加 -Dsurefire.failIfNoSpecifiedTests=false，避免无匹配用例时失败 -->
        <profile>
            <id>api-test</id>
            <properties>
                <surefire.groups>api</surefire.groups>
                <surefire.excludedGroups></surefire.excludedGroups>
            </properties>
        </profile>
    </profiles>
</project>
