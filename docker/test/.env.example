# L3 测试环境变量示例（up.sh 以 --env-file 传给 docker compose）
# 首次使用复制为 docker/test/.env（已被 docker/test/.gitignore 忽略，不入库）
# 凭据为测试环境弱密码，仅作用于 continew-admin-test 项目的容器，与生产/演示环境无关

# MySQL root 密码（mysql-test 初始化与应用的 DB_PWD 共用此值）
MYSQL_ROOT_PASSWORD=continew123

# Redis 密码（redis-test requirepass 与应用的 REDIS_PWD 共用此值）
REDIS_PASSWORD=continew123

# 容器时区
TZ=Asia/Shanghai

# 端口探测起点（被占用时 up.sh 自动 +1 续探，最终值写入 docker/test/.ports.env）
APP_PORT=18020
REDIS_PORT=16379

# 应用 JVM 参数（留空使用默认；示例：-Xms512m -Xmx1024m）
JAVA_OPTS=
